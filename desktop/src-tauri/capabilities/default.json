{
  "identifier": "default",
  "description": "Default capabilities for CScode desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-title",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:app:default",
    "core:tray:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "global-shortcut:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}
